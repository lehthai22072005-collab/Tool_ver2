{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "document_id", "source_file", "source_sha256", "text_length", "model", "processing", "entities", "warnings", "errors"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "document_id": {"type": "string", "minLength": 1},
    "source_file": {"type": "string", "minLength": 1},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text_length": {"type": "integer", "minimum": 0},
    "model": {"type": "object"},
    "processing": {"type": "object"},
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entity_id", "label", "text", "normalized_text", "start_char", "end_char", "confidence", "chunk_ids", "source"],
        "properties": {
          "entity_id": {"type": "string"},
          "label": {"type": "string"},
          "text": {"type": "string", "minLength": 1},
          "normalized_text": {"type": "string"},
          "start_char": {"type": "integer", "minimum": 0},
          "end_char": {"type": "integer", "minimum": 1},
          "paragraph_index": {"type": ["integer", "null"]},
          "block_id": {"type": ["string", "null"]},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "chunk_ids": {"type": "array", "items": {"type": "string"}},
          "source": {"const": "phobert"}
        }
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}}
  }
}
